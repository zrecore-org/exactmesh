# usage: cmake -DGEN=<gen_corpus> -DEXPECTED=<EXPECTED_SHA256.txt> -DWORKDIR=<dir> -P check_corpus.cmake
# Generates the G1 corpus twice (must be byte-identical) and compares the sha256 of every file with the recorded list; the file count must match too.
foreach(RUN a b)
  file(REMOVE_RECURSE "${WORKDIR}_${RUN}")
  execute_process(COMMAND "${GEN}" "${WORKDIR}_${RUN}" --many 200 RESULT_VARIABLE RC OUTPUT_QUIET)
  if(NOT RC EQUAL 0)
    message(FATAL_ERROR "gen_corpus failed (${RC})")
  endif()
endforeach()
file(REMOVE_RECURSE "${WORKDIR}")
file(RENAME "${WORKDIR}_a" "${WORKDIR}")
file(STRINGS "${EXPECTED}" LINES)
set(N 0)
foreach(L ${LINES})
  string(REGEX MATCH "^([0-9a-f]+)  \\./(.*)$" M "${L}")
  if(NOT M)
    message(FATAL_ERROR "bad line in ${EXPECTED}: ${L}")
  endif()
  set(WANT "${CMAKE_MATCH_1}")
  set(REL "${CMAKE_MATCH_2}")
  file(SHA256 "${WORKDIR}/${REL}" GOT)
  file(SHA256 "${WORKDIR}_b/${REL}" GOT2)
  if(NOT GOT STREQUAL WANT)
    message(FATAL_ERROR "${REL}: sha256 ${GOT} differs from the recorded ${WANT}")
  endif()
  if(NOT GOT STREQUAL GOT2)
    message(FATAL_ERROR "${REL}: two runs differ (not reproducible)")
  endif()
  math(EXPR N "${N} + 1")
endforeach()
file(GLOB_RECURSE ALL RELATIVE "${WORKDIR}" "${WORKDIR}/*")
list(LENGTH ALL NALL)
if(NOT NALL EQUAL N)
  message(FATAL_ERROR "generated ${NALL} files, ${N} recorded")
endif()
file(REMOVE_RECURSE "${WORKDIR}_b")
message(STATUS "all ${N} files match ${EXPECTED}")
